# Zig build artifacts
.zig-cache/
zig-out/

# Local configuration. `.env.example` is the committed reference; copy it to
# `.env` and edit. Vortex runs fine with no `.env` at all — it falls back to
# built-in defaults — so nothing here is required to build or run.
.env

# On-disk blocklist cache (VORTEX_CACHE_DIR). Written on every successful fetch
# and read back when one fails, so it is real state — but it is a copy of
# someone else's list, it is megabytes, and it is rebuilt on the next run.
.vortex-cache/

# Editor / tooling local state
.claude/settings.local.json
.vscode/
.idea/

# macOS
.DS_Store
