# Vortex configuration.
#
# Precedence, later wins:  built-in defaults  <  this file  <  process environment
#
# So a value here overrides the default, and `VORTEX_LISTEN_PORT=5355 ./vortex`
# overrides this file without editing it. Every line below may be commented out;
# anything unset falls back to the default shown in brackets.
#
# Load a different file with VORTEX_ENV_FILE=/path/to/other.env — but note that
# a file named explicitly that way must exist, whereas a missing `.env` is fine.
#
# Syntax: KEY=value, with optional `export `, whitespace around `=`, and single
# or double quotes. `#` starts a comment (needs whitespace before it if the
# value is unquoted, so URL fragments survive). Backslash escapes and multi-line
# values are not supported.

# ---- Listener ----------------------------------------------------------
# Address and port Vortex answers client queries on.
# Binding anything other than 127.0.0.1 is NOT yet safe: there is no concurrency
# cap (P1.5) and no rate limiting (P2.7). See docs/progress.md, "localhost cliff".
VORTEX_LISTEN_HOST = "127.0.0.1"
VORTEX_LISTEN_PORT = 5354

# ---- Upstream resolver -------------------------------------------------
# Where non-blocked queries get forwarded. [192.168.1.1 : 53]
#VORTEX_UPSTREAM_HOST = "192.168.1.1"
#VORTEX_UPSTREAM_PORT = 53

# Local address the shared upstream socket binds to. Port 0 = ephemeral, which
# is what you want unless pinning a source port through a firewall. [0.0.0.0 : 0]
#VORTEX_UPSTREAM_BIND_HOST = "0.0.0.0"
#VORTEX_UPSTREAM_BIND_PORT = 0

# ---- Response cache ----------------------------------------------------
# Maximum entries held in the TTL-aware response cache. [10000]
#
# A bound, not a tuning hint: without one the cache is an unbounded, network-fed
# allocation, since a flood of distinct names would grow it until the allocator
# failed. Keys are 258 bytes and the map reserves capacity in powers of two at
# 80% load, so 10000 entries costs ~4.1 MB of key array whether or not it is
# full. Set to 0 to disable caching entirely — the first thing to turn off when
# diagnosing a stale-answer complaint.
#VORTEX_CACHE_MAX_ENTRIES = 10000

# ---- Concurrency -------------------------------------------------------
# Worker threads for per-query handlers. [CPU count - 1]
#
# The ceiling on handler parallelism. Past it, a handler is not queued: it runs
# on the ingress thread, which stops receiving until it returns. 0 is legal and
# means exactly that for every query. The background loops (dispatcher, sweeper,
# refresher) always get threads of their own on top of this, so no value here
# can starve them.
#VORTEX_HANDLER_THREADS = 3

# Queries forwarded upstream and still awaiting a reply. [4096]
#
# The bound on what a flood can hold open: each forwarded query keeps a slot
# until its reply arrives or the 5 s deadline sweeps it. Past the cap a query
# that would be forwarded is DROPPED — no reply, so spoofed-source floods
# reflect nothing. Blocked names and cache hits never take a slot and are still
# answered. Shed queries are counted and logged once a second. Range 1..65536
# (the proxy ID is 16 bits); 0 is an error, not "unlimited".
#VORTEX_MAX_PENDING = 4096

# Concurrent TCP client connections. [64]
#
# DNS over TCP is where a client retries after a truncated (TC=1) UDP answer,
# and Vortex advertises a 1232-byte EDNS buffer (DNS Flag Day 2020) precisely
# because this listener exists to catch those retries. Each connection is a
# thread for as long as it stays open, so this is a cap: past it, a new
# connection is closed on arrival. Idle connections are closed after 10 s.
# 0 disables TCP entirely — and raises the EDNS size forwarded queries may
# advertise to 4096, since a truncated answer with nowhere to retry is worse.
#VORTEX_MAX_TCP_CONNS = 64

# ---- Blocklists --------------------------------------------------------
# Each list is a URL *or* a local file path, decided by the value's scheme:
#
#   https:// or http://  fetched over the network
#   file://              read from disk, scheme stripped (file:///etc/x = /etc/x)
#   anything else        read from disk as a path, relative or absolute
#
# These two were VORTEX_BLOCKLIST_URL / VORTEX_SUFFIX_BLOCKLIST_URL before they
# learned to take a path. The old names are a startup ERROR naming the
# replacement, not a silent fall back to the default list.

# Exact-match list, hosts format. [StevenBlack/hosts]
VORTEX_BLOCKLIST_SOURCE = "https://raw.githubusercontent.com/StevenBlack/hosts/refs/heads/master/hosts"

# Suffix/wildcard list, one BARE domain per line. [oisd small, domainswild2]
# Use `big.oisd.nl` for wider coverage; `small` is the conservative list.
#
# It must be `domainswild2`, NOT `domainswild`. The `2` variant omits the `*.`
# prefix, and a `*.` prefix is not stripped by the parser — such a list loads
# without any error and then matches nothing, blocking zero domains.
#
# Was hagezi light-onlydomains until 2026-08-10, when that entire GitHub account
# disappeared (the account, not just the file — there is no successor URL).
#VORTEX_SUFFIX_BLOCKLIST_SOURCE = "https://small.oisd.nl/domainswild2"

# A URL fetch that fails is retried three times (immediately, then +1s, then
# +2s) and only the transient cases are retried at all: connection failures,
# 5xx, and 429. A 404 or 403 is a configuration problem a retry cannot fix, so
# it goes straight to the cache below.
#
# A named FILE that does not exist is fatal, and stays fatal regardless of every
# setting in this section: you asked for that blocklist, a missing path is not a
# transient network condition, and starting with an empty set would be a silent
# fail-open.
#
# For development, point both at the checked-in fixtures. Startup is then
# instant rather than the ~25s two HTTP fetches cost, and touches no network:
#
#   VORTEX_BLOCKLIST_SOURCE        = "./testdata/blocklist.hosts"
#   VORTEX_SUFFIX_BLOCKLIST_SOURCE = "./testdata/suffix.txt"
#
# That also sidesteps oisd.nl's per-IP rate limit, which answers HTTP 503 when
# you trip it — a handful of quick restarts used to be enough to leave Vortex
# unable to start at all. It now retries that, and falls back to the cache.

# ---- Blocklist resilience (P2.2) ---------------------------------------
# On-disk copy of each fetched list, written on every success and read back when
# a fetch fails. This is what turns "GitHub had a bad minute" from an outage
# into a log line. [.vortex-cache]
#
# Relative to the working directory, like `.env` itself — a service unit should
# point this somewhere it owns. Each file carries a `# vortex-cache` header
# recording the URL it came from, so changing a source does not silently
# resurrect the previous provider's list. Set to EMPTY to disable the cache and
# depend on the network every run:
#
#   VORTEX_CACHE_DIR =
#
#VORTEX_CACHE_DIR = ".vortex-cache"

# What to do when a list cannot be obtained at all — neither fetched nor
# restored from cache: open | closed. [open]
#
#   open    start anyway with an empty list, logging at ERROR, and keep
#           retrying on a short interval until a list arrives
#   closed  refuse to start
#
# Neither is safe, which is why it is a setting. `closed` means a transient
# outage at the list host takes your whole network's DNS down. `open` means the
# resolver keeps resolving and silently blocks nothing — so it is deliberately
# loud, and the refresher drops to a 5-minute retry until it has a list.
#
# `open` is the default because a resolver that will not start is a worse outage
# than one that is not yet filtering.
#VORTEX_BLOCKLIST_ON_FAILURE = "open"

# How often to rebuild both lists from their sources, in seconds. 0 disables
# refresh entirely. [86400 — daily]
#
# Without this, a process that stays up for months serves the list it fetched on
# the day it started. A refresh builds a whole new generation off to the side and
# swaps it in; queries in flight are unaffected, and a refresh that would empty
# a list that currently has entries is REFUSED rather than installed — that is
# what a 200 OK serving an error page looks like by the time it reaches the
# parser, and installing it would disarm every block while the process went on
# looking healthy.
#
# Set to 0 when pointing the sources at local files you are editing by hand.
#VORTEX_BLOCKLIST_REFRESH_SECS = 86400

# ---- Logging -----------------------------------------------------------
# How much to log: off | error | warn | info | debug. `warning` and `err` also
# work, and case does not matter. [debug in a Debug build, info in a release one]
#
# Per-query verdict records are logged at `debug`. Note that those name every
# domain every client on your network looks up — turn them on deliberately, and
# see P4.6 on retention, because that is PII. `off` disables logging entirely.
#VORTEX_LOG_LEVEL = "info"

# Record format: auto | logfmt | text. [auto]
#   auto    - text when stderr is a terminal, logfmt when it is a pipe or file
#   logfmt  - ts=... level=... scope=... msg="..."  (one parseable record a line)
#   text    - std.log's colored `level(scope): message`, for reading over a shoulder
#VORTEX_LOG_FORMAT = "auto"
