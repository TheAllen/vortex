# Vortex configuration for the systemd unit — installed as /etc/vortex/vortex.env.
#
# Only what a service install has to change is set here. Every other knob, and
# the reasoning behind each default, is documented in .env.example at the root
# of the repository; anything left unset takes the default shown there.
#
# Apply changes with `systemctl restart vortex` — there is no reload yet.

# ---- Listener ----------------------------------------------------------
# `::` is every address, IPv6 *and* IPv4: on Linux's default
# (net.ipv6.bindv6only=0) an IPv6 wildcard socket also accepts IPv4 clients, so
# one setting covers both families over both UDP and TCP. On a host where that
# sysctl is 1, use 0.0.0.0 — IPv4 only — or a specific address.
#
# Port 53 on a wildcard collides with systemd-resolved's stub listener on
# 127.0.0.53:53, and Vortex will fail to start with AddressInUse until it is
# turned off. See the README, "Running under systemd".
#
# Rate limiting (P2.7) is not implemented. Until it is, keep this listener off
# the public internet — firewall port 53 to the networks you serve.
VORTEX_LISTEN_HOST = "::"
VORTEX_LISTEN_PORT = 53

# ---- Upstream resolver -------------------------------------------------
# Where non-blocked queries are forwarded. The built-in default (192.168.1.1)
# is a home router's address and is almost certainly wrong for a server, so it
# is set here on purpose: change it to your resolver.
VORTEX_UPSTREAM_HOST = "1.1.1.1"
VORTEX_UPSTREAM_PORT = 53

# For an IPv6 upstream, the shared upstream socket has to bind an IPv6 address:
#VORTEX_UPSTREAM_HOST = "2606:4700:4700::1111"
#VORTEX_UPSTREAM_BIND_HOST = "::"

# ---- State -------------------------------------------------------------
# The unit's StateDirectory, so cached lists survive restarts and are what
# Vortex falls back to when a fetch fails at boot.
VORTEX_CACHE_DIR = "/var/lib/vortex/blocklists"

# ---- Logging -----------------------------------------------------------
# The journal is not a terminal, so `auto` already picks logfmt; pinned anyway
# so a `journalctl -o cat` pipeline does not depend on how it was detected.
VORTEX_LOG_FORMAT = "logfmt"
VORTEX_LOG_LEVEL = "info"
